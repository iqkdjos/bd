digraph database_schema {
    rankdir=RL;
    splines=ortho;

    node [shape=plain];
    edge [fontsize=12, penwidth=1];

    // Таблица manufacturer
    manufacturer [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
            <TR><TD COLSPAN="2" BGCOLOR="#eeeeee"><B>manufacturer</B></TD></TR>
            <TR><TD ALIGN="LEFT">manufacturer_id</TD><TD ALIGN="LEFT">int (PK)</TD></TR>
            <TR><TD ALIGN="LEFT">manufacturer_name</TD><TD ALIGN="LEFT">varchar(225)</TD></TR>
            <TR><TD ALIGN="LEFT">year_founded</TD><TD ALIGN="LEFT">int</TD></TR>
            <TR><TD ALIGN="LEFT">where_is</TD><TD ALIGN="LEFT">country</TD></TR>

        </TABLE>>];

    // Таблица water
    water [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD COLSPAN="2" BGCOLOR="#eeeeee"><B>water</B></TD></TR>
            <TR><TD ALIGN="LEFT">water_id</TD><TD ALIGN="LEFT">int (PK)</TD></TR>
            <TR><TD ALIGN="LEFT">water_name</TD><TD ALIGN="LEFT">varchar(225)</TD></TR>
            <TR><TD ALIGN="LEFT">price</TD><TD ALIGN="LEFT">int</TD></TR>
            <TR><TD ALIGN="LEFT">type</TD><TD ALIGN="LEFT">varchar(225)</TD></TR>
            <TR><TD ALIGN="LEFT">manufacturer_id</TD><TD ALIGN="LEFT">int (FK)</TD></TR>
        </TABLE>>];

    // Таблица water_minerals
    water_minerals [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
            <TR><TD COLSPAN="2" BGCOLOR="#eeeeee"><B>water_minerals</B></TD></TR>
            <TR><TD ALIGN="LEFT">water_id</TD><TD ALIGN="LEFT">int (PK, FK)</TD></TR>
            <TR><TD ALIGN="LEFT">mineral_id</TD><TD ALIGN="LEFT">int (PK, FK)</TD></TR>
            <TR><TD ALIGN="LEFT">from</TD><TD ALIGN="LEFT">decimal(5,2)</TD></TR>
            <TR><TD ALIGN="LEFT">to</TD><TD ALIGN="LEFT">decimal(5,2)</TD></TR>
        </TABLE>>];

    // Таблица minerals
    minerals [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD COLSPAN="2" BGCOLOR="#eeeeee"><B>minerals</B></TD></TR>
            <TR><TD ALIGN="LEFT">mineral_id</TD><TD ALIGN="LEFT">int (PK)</TD></TR>
            <TR><TD ALIGN="LEFT">minerals_name</TD><TD ALIGN="LEFT">varchar(225)</TD></TR>
            <TR><TD ALIGN="LEFT">formula</TD><TD ALIGN="LEFT">varchar(225)</TD></TR>
            <TR><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">varchar(225)</TD></TR>
        </TABLE>>];

    // Связи

    water -> manufacturer [label="N..1"];
    water_minerals -> water [label="N..1"];
    water_minerals -> minerals [label="N..1"];
}
